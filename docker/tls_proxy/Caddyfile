# TLS proxy in front of the Streamlit frontend (Stage 15).
# Users open https://localhost. Plain http (port 80, and the old 8501 address)
# gets a redirect to https instead of a broken page. The certificate comes from
# scripts/make_certs.sh; Caddy's own automatic certificates are switched off.
# Inside the container it listens on high ports, so it can run as non-root.
{
	admin off
	auto_https off
	persist_config off
}

https://:8443 {
	tls /certs/server.crt /certs/server.key
	# Reused upstream connections waited ~40 ms per request (a Nagle and
	# delayed-ACK stall with Tornado); a fresh connection on the Docker
	# network costs well under 1 ms. The websocket is unaffected.
	reverse_proxy frontend:8501 {
		transport http {
			keepalive off
		}
	}
	# The ops runner stops the frontend while a retrain runs (8 GB limit), and
	# the frontend can also be restarting. Users then get this short page
	# instead of Caddy's empty 502.
	handle_errors {
		header Content-Type "text/html; charset=utf-8"
		header Retry-After "120"
		respond <<HTML
			<!doctype html><html lang="en"><head><meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<meta http-equiv="refresh" content="30"><title>Air quality forecast</title></head>
			<body style="font-family:sans-serif;max-width:32rem;margin:3rem auto;padding:0 1rem">
			<h1>Back in a few minutes</h1>
			<p>The forecast page is paused while a new model is trained, or it is restarting.
			This usually takes two to three minutes. The page reloads by itself.</p>
			</body></html>
			HTML 503
	}
}

http://:8080 {
	redir https://{host}{uri} permanent
}
