# Copy to .env and fill in. .env is gitignored - never commit real secrets.
OPS_API_KEY=change-me-to-a-long-random-string
HOST_PROJECT=/absolute/path/to/this/folder
HOST_UID=1000
HOST_GID=1000
LOG_LEVEL=INFO
BACKEND_URL=https://backend:8000
MODEL_SERVER_URL=http://model-server:5001
MLFLOW_TRACKING_URI=http://mlflow:5000
REPLAY_SPEED_HPS=1.0
RETRAIN_COOLDOWN_MIN=30
PUSHGATEWAY_URL=http://pushgateway:9091
GRAFANA_ADMIN_PASSWORD=change-me
PUSHGATEWAY_HOST_PORT=19091
