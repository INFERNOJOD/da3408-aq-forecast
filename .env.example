# Copy to .env and fill in (scripts/bootstrap.sh does this for you).
# .env is gitignored - never commit real secrets.
#
# Two readers: docker compose (secrets, paths, ports) and the tools I run on the
# host (ops runner, rollback script, pipeline), which load this file too. So it
# holds no container-network addresses such as http://mlflow:5000: compose sets
# those per service, and on the host they would not resolve.
OPS_API_KEY=change-me-to-a-long-random-string
GRAFANA_ADMIN_PASSWORD=change-me
HOST_PROJECT=/absolute/path/to/this/folder
HOST_UID=1000
HOST_GID=1000
LOG_LEVEL=INFO
REPLAY_SPEED_HPS=1.0
RETRAIN_COOLDOWN_MIN=30
PUSHGATEWAY_HOST_PORT=19091
# Where pipeline runs on the host push their stage metrics (the batch container
# overrides it with http://pushgateway:9091).
PUSHGATEWAY_URL=http://localhost:19091
